name: Search engine discovery

# Keeps every page submitted to the free indexes forever, with zero manual work.
# Runs when a page changes, once a week, or on demand.
on:
  push:
    branches: [main]
    paths:
      - '**.html'
      - 'llms.txt'
      - 'scripts/**'
      - '.github/workflows/discover.yml'
  schedule:
    - cron: '17 4 * * 1'   # Mondays 04:17 UTC
  workflow_dispatch:

permissions:
  contents: write

jobs:
  submit:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0   # needed for per-file lastmod from git history

      - uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Regenerate sitemap.xml and feed.xml
        run: node scripts/build.mjs

      - name: Commit refreshed sitemap/feed (only if changed)
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add sitemap.xml feed.xml
          if git diff --cached --quiet; then
            echo "sitemap/feed unchanged"
          else
            git commit -m "Refresh sitemap and feed"
            git push
          fi

      # Read the freshly generated sitemap and push every URL to the free
      # submission APIs. Failures are logged by the script, never fatal.
      - name: Submit all URLs to Bing + IndexNow
        env:
          BING_API_KEY: ${{ secrets.BING_API_KEY }}
        run: node scripts/ping-engines.mjs
